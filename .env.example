# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eventcraft
DB_POOL_MAX=10

# Authentication
BETTER_AUTH_SECRET=<at-least-32-random-characters>

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<your-api-key>
LLM_MODEL_PRIMARY=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# Google OAuth (optional - both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quotas
QUOTA_GENERATIONS_PER_DAY=10
QUOTA_ASSISTANT_MESSAGES_PER_DAY=50

# Networking
TRUST_PROXY_HOPS=0

# Logging
LOG_LEVEL=info

# Testing (fake LLM provider)
FAKE_LLM_FAIL_SECTIONS=
FAKE_LLM_DELAY_MS=0
